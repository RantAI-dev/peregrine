+/// Temporary phase timers for the S4.9k standings (not part of the engine).
+/// Off unless `PEREGRINE_BERT_PHASES` is set; the counters are exported so the
+/// cellprof example can print them. A companion patch file records this change.
+pub mod phases {
+    use std::sync::atomic::{AtomicU64, Ordering};
+
+    pub const N: usize = 7;
+    const NAMES: [&str; N] = ["embed+norm", "attention", "layer norm", "gelu", "pooling",
+                              "quantise ln", "quantise gelu"];
+    pub static C: [AtomicU64; N] = [
+        AtomicU64::new(0), AtomicU64::new(0), AtomicU64::new(0),
+        AtomicU64::new(0), AtomicU64::new(0), AtomicU64::new(0), AtomicU64::new(0),
+    ];
+
+    #[inline]
+    pub fn on() -> bool {
+        std::env::var_os("PEREGRINE_BERT_PHASES").is_some()
+    }
+
+    #[inline]
+    pub fn add(i: usize, ns: u64) {
+        C[i].fetch_add(ns, Ordering::Relaxed);
+    }
+
+    pub fn reset() {
+        for c in &C {
+            c.store(0, Ordering::Relaxed);
+        }
+    }
+
+    pub fn names() -> &'static [&'static str; N] {
+        &NAMES
+    }
+
+    pub fn take() -> [u64; N] {
+        let mut out = [0u64; N];
+        for (o, c) in out.iter_mut().zip(C.iter()) {
+            *o = c.swap(0, Ordering::Relaxed);
+        }
+        out
+    }
+}
